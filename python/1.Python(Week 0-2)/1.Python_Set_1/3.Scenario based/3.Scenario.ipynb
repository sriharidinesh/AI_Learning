    "def bonus():\n",
    "    salary = int(input(\"Enter your salary: \"))\n",
    "    if salary > 50000:\n",
    "        bonus = int(salary * .10)\n",
    "        print(f\"Your Eligible Bonus: {bonus}\")\n",
    "    else :\n",
    "        print(\"Not Eligible\")"
   ]
