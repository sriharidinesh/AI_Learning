    "def OddEven():\n",
    "    num = int(input(\"Enter the Number:\"))\n",
    "    if ((num %2) == 0):\n",
    "        print(f\"{num} is Even Number\")\n",
    "    else:\n",
    "        print(f\"{num} is Odd Number\")"
   ]
