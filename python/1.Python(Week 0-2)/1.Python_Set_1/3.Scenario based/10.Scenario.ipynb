   "source": [
    "def evenNumbers():\n",
    "    even = []\n",
    "    numbers = list(map(int, input(\"Enter numbers separated by space: \").split()))\n",
    "    for i in numbers:\n",
    "        if i%2 == 0:\n",
    "            even.append(i)\n",
    "    print(even)"
   ]
