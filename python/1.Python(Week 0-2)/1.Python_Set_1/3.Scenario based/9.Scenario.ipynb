   "source": [
    "def findleapyear():\n",
    "    y = int(input(\"Enter the year: \"))\n",
    "    if (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0):\n",
    "        print(f\"{y} is a leap year\")\n",
    "    else:\n",
    "        print(f\"{y} is not a leap year\")"
   ]
  },
